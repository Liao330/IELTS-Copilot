# ================================================
# IELTS Copilot 部署配置模板
# 复制为 .env.deploy 后填入你的实际值
# cp .env.deploy.example .env.deploy
# ================================================

# 服务器 SSH 连接（必填）
DEPLOY_SERVER_IP=你的服务器IP
DEPLOY_SERVER_USER=root

# 远程部署路径
DEPLOY_REMOTE_DIR=/opt/ielts-copilot

# 服务端口
DEPLOY_PORT=8391

# CORS 允许来源（Docker 环境中使用）
CORS_ORIGINS=http://你的服务器IP:8391
